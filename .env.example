# Copy to .env (never commit .env) and fill in the required values. On a server, put the same lines in
# /etc/medical-records/app.env instead (see DEPLOY.md, B7).

# Google sign-in (required). The redirect URI must match the Google console exactly; http:// only for localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# The admin's Google email (required). Everyone else needs an invite from the admin.
ADMIN_EMAIL=

# At least 32 random characters (required): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Where data lives (relative paths are inside the project folder).
DATABASE_URL=sqlite:///data/medical_records.db
FILES_DIR=data/files

# Limits.
MAX_UPLOAD_SIZE_MB=20
DEFAULT_QUOTA_MB=100

# Sign-ins end after this many hours unused, and after this many days in any case.
SESSION_IDLE_HOURS=24
SESSION_MAX_AGE_DAYS=14

# Privacy contact shown in the app (default: ADMIN_EMAIL).
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=

# Server only (see DEPLOY.md): virus scan, and the backup status for /api/health/backup.
CLAMAV_SOCKET=
BACKUP_STATUS_DIR=

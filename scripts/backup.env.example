# Settings for scripts/backup.sh and scripts/restore.sh.
# Copy to /etc/medical-records/backup.env and make it readable by root only:
#   sudo install -m 600 -o root -g root scripts/backup.env.example /etc/medical-records/backup.env
# See DEPLOY.md for where each value comes from.

# The app's data folder: medical_records.db and files/ live directly inside it.
DATA_DIR=/srv/medical-records/data

# Oracle Object Storage, Mumbai, through the S3-compatible endpoint:
#   s3:https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com/<bucket>
RESTIC_REPOSITORY=s3:https://NAMESPACE.compat.objectstorage.ap-mumbai-1.oraclecloud.com/medical-records-backup
AWS_DEFAULT_REGION=ap-mumbai-1
# The backup user's Customer Secret Key (read-write on the backup bucket only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The restic password. Losing it means losing every backup: keep a copy in your password manager.
RESTIC_PASSWORD_FILE=/etc/medical-records/restic-password
RESTIC_CACHE_DIR=/var/cache/medical-records-backup

# Where the lock and the last-success time are kept.
STATE_DIR=/var/lib/medical-records-backup

# How restore.sh --apply stops and starts the app (scripts/host-setup.sh writes these):
APP_STOP_CMD="medical-records-compose stop app"
APP_START_CMD="medical-records-compose start app"

# Owner (uid:gid) restore.sh --apply gives the restored data: the app container runs as 10001:10001.
# Empty: keep the owner of the data it replaces (or of DATA_DIR's parent on a new server).
DATA_OWNER=10001:10001

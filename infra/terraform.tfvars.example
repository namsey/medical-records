# Copy to terraform.tfvars (git-ignored). No secrets belong here.
tenancy_ocid        = "ocid1.tenancy.oc1..xxxx"
region              = "ap-mumbai-1"
ssh_allowed_cidrs   = { laptop = "203.0.113.7/32" }
ssh_public_key_path = "~/.ssh/oracle-medical-records.pub"
alert_email         = "you@example.com"

# Optional: the default is prod + staging inside the Always Free totals (see variables.tf). If you set it, give
# every field of both environments; totals must stay at 2 OCPUs, 12 GB RAM and 200 GB of volumes.
